# Public browser origin. Use HTTPS behind a reverse proxy for internet access.
APP_ORIGIN=http://localhost:3000
# Required: choose a unique password with at least 12 characters.
ADMIN_PASSWORD=
# Required: generate with: openssl rand -hex 32
# Keep this key with your backups; changing it makes saved Tuya tokens unreadable.
ENCRYPTION_KEY=

# Optional: notifications are stored locally until all three values are set.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Optional: background notifications for PWA/desktop, independent of email.
# Generate once with npm run push:keys; keep these keys across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real operator contact, e.g. mailto:you@your-domain.com.
VAPID_SUBJECT=

# Docker Compose: bind locally by default; set a Tailscale IP for private access.
BIND_IP=127.0.0.1
HTTP_PORT=3000
# IMAGE=ghcr.io/tomusdrw/tuya-energy-monitor:sha-<commit>

# Local development only (container sets these itself).
# DATA_DIR=./data
# PYTHON_BIN=.venv/bin/python
# HOST=127.0.0.1
# PORT=3000
